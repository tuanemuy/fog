`$value instanceof $type` where {
  $type <: or {
    `ApplicationError`,
    `NotFoundError`,
    `ConflictError`,
    `ValidationError`,
    `UnauthorizedError`,
    `ForbiddenError`,
    `SystemError`,
    `BusinessRuleError`,
    `RehydrationError`,
    `AppServerError`
  },
  register_diagnostic(span=$type, message="Use the guard function (isXxxError) instead of instanceof for error type checks.")
}
