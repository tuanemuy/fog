# Paths are relative to apps/web. Use a remote libSQL URL for cloud storage.
DATABASE_URL=file:./data/app.db
APP_URL=http://localhost:3000
#DATABASE_AUTH_TOKEN=
#DATABASE_ENCRYPTION_KEY=
#HOSTNAME=127.0.0.1
#PORT=3000

# Public AI clients and exact allowed redirect URIs.
#FOG_AI_CLIENTS='[{"id":"fog-local-client","name":"ローカルAIクライアント","redirectUris":["http://127.0.0.1:3456/callback"]}]'

# Google Web client; register APP_URL/auth/google/callback.
#FOG_GOOGLE_CLIENT_ID=
#FOG_GOOGLE_CLIENT_SECRET=

# Recovery SMTP: 465 uses TLS, other remote ports require STARTTLS.
#FOG_SMTP_HOST=
#FOG_SMTP_PORT=587
#FOG_SMTP_FROM=
#FOG_SMTP_USER=
#FOG_SMTP_PASSWORD=

# Local fixture only; rejected outside HTTP loopback APP_URL.
#FOG_OIDC_FIXTURE_ORIGIN=http://127.0.0.1:3457
#FOG_SMTP_LOCAL=true
