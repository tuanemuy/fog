# Copy to `.dev.vars` for local Wrangler development. The request and state
# configs share this directory, but `wrangler.state.toml` declares an empty
# required-secret set so Wrangler does not expose these request-only values to
# the state Worker.
#
# Generate each active secret independently:
#
#   openssl rand -base64 48
#
# Never commit `.dev.vars`.

# Signs session cookies. Rotating it immediately invalidates every session.
SESSION_SECRET=""

# HMAC key used by the request Worker to derive opaque Identity Directory
# locators. It must not be available to the state Worker.
DIRECTORY_ROUTING_SECRET_ACTIVE=""

# Set only during a routing-key rotation window. Temporarily add this name to
# `wrangler.request.toml` `[secrets].required` so Wrangler admits it, then
# remove both declarations after the checkpoint scan confirms no
# previous-generation mappings/reverse locators.
#DIRECTORY_ROUTING_SECRET_PREVIOUS=""
#DIRECTORY_ROUTING_GENERATION_PREVIOUS="local-v0"

# State-worker-only external adapter secrets may be added later, but must also
# be explicitly listed in `wrangler.state.toml` `[secrets].required`.
