# Copy to .dev.vars for local Workers development. Never commit real values.
DATABASE_URL="libsql://fog-staging.example.turso.io"
DATABASE_AUTH_TOKEN="replace-with-staging-token"
FOG_GOOGLE_CLIENT_ID="replace-with-staging-client-id"
FOG_GOOGLE_CLIENT_SECRET="replace-with-staging-client-secret"
# Optional JSON array. Treat client secrets inside it as secrets.
# FOG_AI_CLIENTS='[{"id":"local-client","name":"Local client","redirectUris":["https://client.example/callback"]}]'
