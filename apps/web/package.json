{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm cf:types",
    "predev": "pnpm cf:types",
    "dev": "wrangler dev -c wrangler.request.toml -c wrangler.state.toml --persist-to .wrangler/state",
    "dev:cf": "pnpm dev",
    "prebuild": "pnpm cf:types",
    "build": "pnpm build:request && pnpm build:state",
    "build:cf": "pnpm build",
    "build:request": "vite build --config vite.config.cloudflare.ts --mode development",
    "build:state": "wrangler deploy --config wrangler.state.toml --dry-run --outdir dist/state",
    "start": "wrangler dev -c wrangler.request.toml -c wrangler.state.toml --persist-to .wrangler/state",
    "start:cf": "pnpm start",
    "preview": "vite preview --config vite.config.cloudflare.ts",
    "typecheck": "tsgo",
    "cf:types": "wrangler types -c wrangler.request.toml -c wrangler.state.toml",
    "test:integration:prepare": "wrangler deploy --config wrangler.state.toml --dry-run --outdir dist/test/state",
    "lifecycle:dev": "wrangler dev --config wrangler.lifecycle.toml --local --persist-to .wrangler/lifecycle",
    "lifecycle:run": "tsx scripts/run-lifecycle.ts",
    "pitr:operator": "tsx scripts/pitr-operator.ts",
    "identity:operator": "tsx scripts/identity-maintenance.ts",
    "secrets:check:staging": "pnpm --filter @repo/infra-cloudflare render staging && tsx scripts/validate-secrets.ts staging",
    "secrets:check:production": "pnpm --filter @repo/infra-cloudflare render production && tsx scripts/validate-secrets.ts production",
    "deploy:staging": "pnpm deploy:staging:state && pnpm deploy:staging:request",
    "predeploy:staging": "pnpm --filter @repo/infra-cloudflare render staging",
    "deploy:staging:state": "wrangler deploy --config wrangler.state.staging.toml",
    "deploy:staging:request": "wrangler deploy --config wrangler.request.staging.toml",
    "deploy:staging:dry": "pnpm deploy:staging:state:dry && pnpm deploy:staging:request:dry",
    "predeploy:staging:dry": "pnpm --filter @repo/infra-cloudflare render:offline staging",
    "deploy:staging:state:dry": "wrangler deploy --config wrangler.state.staging.toml --dry-run --outdir dist/deploy/staging/state",
    "deploy:staging:request:dry": "wrangler deploy --config wrangler.request.staging.toml --dry-run --outdir dist/deploy/staging/request",
    "deploy:production": "pnpm deploy:production:state && pnpm deploy:production:request",
    "predeploy:production": "pnpm --filter @repo/infra-cloudflare render production",
    "deploy:production:state": "wrangler deploy --config wrangler.state.production.toml",
    "deploy:production:request": "wrangler deploy --config wrangler.request.production.toml",
    "deploy:production:dry": "pnpm deploy:production:state:dry && pnpm deploy:production:request:dry",
    "predeploy:production:dry": "pnpm --filter @repo/infra-cloudflare render:offline production",
    "deploy:production:state:dry": "wrangler deploy --config wrangler.state.production.toml --dry-run --outdir dist/deploy/production/state",
    "deploy:production:request:dry": "wrangler deploy --config wrangler.request.production.toml --dry-run --outdir dist/deploy/production/request"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "^0.5.26",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wrangler": "^4.90.1"
  }
}
