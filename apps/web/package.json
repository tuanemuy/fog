{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types && wrangler types --config wrangler.state.toml --env-interface StateEnv --include-runtime=false worker-configuration.state.d.ts",
    "predev:cf": "wrangler types && wrangler types --config wrangler.state.toml --env-interface StateEnv --include-runtime=false worker-configuration.state.d.ts",
    "dev": "pnpm dev:cf",
    "dev:cf": "vite dev --config vite.config.cloudflare.ts",
    "build": "pnpm build:cf",
    "build:cf": "vite build --config vite.config.cloudflare.ts",
    "build:staging": "vite build --config vite.config.cloudflare.staging.ts",
    "build:production": "vite build --config vite.config.cloudflare.production.ts",
    "start": "pnpm start:cf",
    "start:cf": "pnpm build:cf && wrangler dev -c dist/server/wrangler.json -c wrangler.state.toml",
    "preview": "vite preview --config vite.config.cloudflare.ts",
    "ai-client": "node scripts/ai-client.ts",
    "operator": "node scripts/operator.ts",
    "typecheck": "tsgo && tsgo -p tsconfig.state.json",
    "cf:types": "wrangler types && wrangler types --config wrangler.state.toml --env-interface StateEnv --include-runtime=false worker-configuration.state.d.ts",
    "deploy:built": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:built:dry": "wrangler deploy --config dist/server/wrangler.json --dry-run --outdir=dist/worker",
    "deploy:staging": "pnpm build:staging && pnpm deploy:built",
    "deploy:staging:dry": "pnpm build:staging && pnpm deploy:built:dry",
    "deploy:staging:all": "pnpm build:staging && pnpm deploy:staging:state && pnpm deploy:built",
    "deploy:staging:all:dry": "pnpm build:staging && pnpm deploy:staging:state:dry && pnpm deploy:built:dry",
    "deploy:production": "pnpm build:production && pnpm deploy:built",
    "deploy:production:dry": "pnpm build:production && pnpm deploy:built:dry",
    "deploy:production:all": "pnpm build:production && pnpm deploy:production:state && pnpm deploy:built",
    "deploy:production:all:dry": "pnpm build:production && pnpm deploy:production:state:dry && pnpm deploy:built:dry",
    "deploy:staging:state": "wrangler deploy --config wrangler.state.staging.toml",
    "deploy:staging:state:dry": "wrangler deploy --config wrangler.state.staging.toml --dry-run --outdir=dist/state",
    "deploy:production:state": "wrangler deploy --config wrangler.state.production.toml",
    "deploy:production:state:dry": "wrangler deploy --config wrangler.state.production.toml --dry-run --outdir=dist/state"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "diff": "^8.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "^0.5.26",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wrangler": "^4.90.1"
  }
}
