{
  "name": "fog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "dev:cf": "pnpm --filter @repo/web dev",
    "build": "pnpm --filter @repo/web build",
    "build:cf": "pnpm --filter @repo/web build",
    "start": "pnpm --filter @repo/web start",
    "start:cf": "pnpm --filter @repo/web start",
    "preview": "pnpm --filter @repo/web preview",
    "typecheck": "tsgo && pnpm -r typecheck",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration:prepare": "pnpm --filter @repo/web test:integration:prepare",
    "test:integration": "pnpm test:integration:prepare && vitest run --config vitest.config.integration.ts && vitest run --config vitest.config.integration-state.ts",
    "test:integration:cf": "pnpm test:integration",
    "test:lifecycle:cli": "pnpm --filter @repo/web lifecycle:run",
    "audit:legacy": "node scripts/audit-legacy.mjs",
    "audit:test-traceability": "node scripts/audit-test-traceability.mjs",
    "cf:types": "pnpm --filter @repo/web cf:types",
    "cf:render:staging": "pnpm --filter @repo/infra-cloudflare render staging",
    "cf:render:production": "pnpm --filter @repo/infra-cloudflare render production",
    "deploy:staging": "pnpm --filter @repo/web deploy:staging",
    "deploy:staging:dry": "pnpm --filter @repo/web deploy:staging:dry",
    "deploy:production": "pnpm --filter @repo/web deploy:production",
    "deploy:production:dry": "pnpm --filter @repo/web deploy:production:dry"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
