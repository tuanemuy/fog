{
  "name": "fog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "dev:node": "pnpm --filter @repo/web dev:node",
    "build": "pnpm --filter @repo/web build",
    "build:node": "pnpm --filter @repo/web build:node",
    "start": "pnpm --filter @repo/web start",
    "start:node": "pnpm --filter @repo/web start:node",
    "typecheck": "tsgo && pnpm -r typecheck",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.node.ts",
    "test:integration:node": "pnpm test:integration",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "db:migrate:node": "pnpm --filter @repo/web db:migrate:node",
    "db:backup": "pnpm --filter @repo/web db:backup",
    "db:restore": "pnpm --filter @repo/web db:restore",
    "db:prune-backups": "pnpm --filter @repo/web db:prune-backups"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "esbuild": "^0.27.7",
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
